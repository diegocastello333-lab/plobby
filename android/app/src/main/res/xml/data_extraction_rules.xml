<?xml version="1.0" encoding="utf-8"?>
<!-- Plobby · Android 12+: nada de la app entra en la copia en la nube ni en la transferencia entre dispositivos
     (la sesión cifrada no sirve en otro móvil y no debe salir de este). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
